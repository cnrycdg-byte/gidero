{
  "expo": {
    "name": "Gidero",
    "slug": "gidero",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gidero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "tr.gidero.app",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B6E5F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tr.gidero.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": {
            "backgroundColor": "#0A1513",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Gidero fişlerinizi fotoğraflamak için kameraya erişir.",
          "photosPermission": "Gidero galerideki fiş fotoğraflarını eklemek için fotoğraflarınıza erişir.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4841364a-3bf4-49a9-b97c-d3d0aabf281d"
    },
    "extra": {
      "eas": {
        "projectId": "4841364a-3bf4-49a9-b97c-d3d0aabf281d"
      }
    },
    "splash": {
      "backgroundColor": "#F4F6F5",
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain"
    }
  }
}